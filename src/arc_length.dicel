@DICEL:FN_ARC_LENGTH:1.0.0

^ir="mul(C2,mul(Ppi,mul(P1,div(P0,C360))))"
^source_lang="python"

fn$arc_length(angle:num, radius:num)->num {
  return (2 * ($ppi * (radius * (angle / 360))))
}
