@DICEL:FN_SURFACE_AREA_CYLINDER:1.0.0

^ir="mul(C2,mul(Ppi,mul(P0,add(P1,P0))))"
^source_lang="python"

fn$surface_area_cylinder(radius:num, height:num)->num {
  return (2 * ($ppi * (radius * (height + radius))))
}
