@DICEL:FN_ASTABLE_DUTY_CYCLE:1.0.0

^ir="mul(div(add(P0,P1),add(P0,mul(C2,P1))),C100)"
^source_lang="python"

fn$astable_duty_cycle(resistance_1:num, resistance_2:num)->num {
  return (((resistance_1 + resistance_2) / (resistance_1 + (2 * resistance_2))) * 100)
}
