@DICEL:FN_CONTAINS_ORIGIN:1.0.0

^ir="and(gt(Pa,C0),and(gt(Pb,C0),lt(add(Pa,Pb),C1)))"
^source_lang="python"

fn$contains_origin(x1:num, y1:num, x2:num, y2:num, x3:num, y3:num)->num {
  return ((($pa > 0) && (($pb > 0) && (($pa + $pb) < 1))) ? 1 : 0)
}
