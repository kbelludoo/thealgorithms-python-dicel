@DICEL:FN_VOLUME_OF_GAS_SYSTEM:1.0.0

^ir="mul(P0,mul(P1,div(PUNIVERSAL_GAS_CONSTANT,P2)))"
^source_lang="python"

fn$volume_of_gas_system(moles:num, kelvin:num, pressure:num)->num {
  return (moles * (kelvin * ($pUNIVERSAL_GAS_CONSTANT / pressure)))
}
