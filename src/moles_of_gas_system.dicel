@DICEL:FN_MOLES_OF_GAS_SYSTEM:1.0.0

^ir="mul(P2,div(P1,mul(P0,PUNIVERSAL_GAS_CONSTANT)))"
^source_lang="python"

fn$moles_of_gas_system(kelvin:num, volume:num, pressure:num)->num {
  return (pressure * (volume / (kelvin * $pUNIVERSAL_GAS_CONSTANT)))
}
